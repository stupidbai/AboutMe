{
  "name": "bai-yunfei-resume",
  "version": "4.1.0",
  "private": true,
  "description": "白云飞企业 AI 合作、项目案例与个人知识门户",
  "type": "module",
  "scripts": {
    "import:knowledge": "node scripts/import-arch3rpro-knowledge.mjs",
    "dev": "vitepress dev site --host 127.0.0.1 --port 8000",
    "start": "npm run dev",
    "build": "vitepress build site",
    "preview": "vitepress preview site --host 127.0.0.1 --port 8000",
    "admin": "npm run build && node scripts/serve-with-admin.mjs",
    "admin:serve": "node scripts/serve-with-admin.mjs",
    "test:database": "node scripts/test-database.mjs",
    "test:rag": "node scripts/test-rag-service.mjs",
    "test:community": "node scripts/test-community-service.mjs",
    "test:admin": "node scripts/test-admin-api.mjs",
    "check": "node scripts/verify-portal.mjs && npm run build && npm run test:community && npm run test:database && npm run test:rag && npm run test:admin",
    "package:release": "npm run check && node scripts/build-release.mjs"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "engines": {
    "node": ">=22.16"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "marked": "^18.0.11",
    "minisearch": "^7.2.0",
    "nodemailer": "^9.1.1",
    "sanitize-html": "^2.17.7"
  }
}
